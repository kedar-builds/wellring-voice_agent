# WellRing Voice Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ---------------------------------------------------------------------------
# API Authentication — REQUIRED, no default
# ---------------------------------------------------------------------------
WELLRING_API_KEY=your-secure-api-key-here

# ---------------------------------------------------------------------------
# Clerk — verified session auth (REQUIRED in production)
# ---------------------------------------------------------------------------
# Secret key from Clerk Dashboard → API Keys (sk_...).
# When set, every dashboard/outbound endpoint requires a valid Clerk session
# JWT (Authorization: Bearer ... OR the __session cookie) from the frontend
# and the verified user id (the JWT `sub`) overrides any client-supplied
# `clerk_id`. When UNSET the backend runs in dev mode: verification is skipped
# and the legacy `clerk_id` request field is trusted instead.
#
# In production this MUST be set. If ENV=production (or RAILWAY_ENVIRONMENT
# resolves to production/prod) and it is missing, the backend refuses to start.
CLERK_SECRET_KEY=

# Deployment environment: 'development' (default), 'production', 'preview' or
# 'staging'. Production-like environments (production/prod/preview/staging)
# REFUSE to boot without CLERK_SECRET_KEY — Railway preview/staging deploys
# often share the production database and must stay protected too.
ENV=development

# OPTIONAL hardening — comma-separated frontend origins whose sessions are
# accepted (Clerk "authorized parties", validated against the JWT `azp` claim).
# Enable only AFTER all users have fresh sessions, because the SDK REJECTS
# tokens whose `azp` claim is missing.
# Example: CLERK_AUTHORIZED_PARTIES=https://wellring-frontend.vercel.app,http://localhost:5173
CLERK_AUTHORIZED_PARTIES=

# DANGER: emergency override to allow dev-mode auth in production. This exposes
# every account's data to anyone holding the static WELLRING_API_KEY. Never set
# this in a real deployment.
ALLOW_INSECURE_DEV_AUTH=false

# ---------------------------------------------------------------------------
# Database — PostgreSQL (recommended for production)
# ---------------------------------------------------------------------------
# Set DATABASE_URL to enable Postgres mode.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Example (local): postgresql://postgres:password@localhost:5432/wellring
# Example (Render): postgresql://wellring_user:xxx@dpg-xxx.render.com/wellring
DATABASE_URL=

# Optional: Staging database URL (e.g. created via scripts/setup_staging_db.sh)
STAGING_DATABASE_URL=

# After setting DATABASE_URL, run the schema migration once:
#   python -m src.db.migrate

# ---------------------------------------------------------------------------
# Database — SQLite (local dev / tests fallback)
# ---------------------------------------------------------------------------
# Only used when DATABASE_URL is not set.
WELLRING_DB_PATH=wellring.db

# ---------------------------------------------------------------------------
# Supabase — managed Postgres (option: use Supabase as the main database)
# ---------------------------------------------------------------------------
# Supabase IS PostgreSQL, so the backend needs no code changes — just point
# DATABASE_URL at Supabase's Postgres.
#
# Get the connection string from: Supabase Dashboard → Project Settings →
# Database → Connection string → "URI".
#   - Direct connection (port 5432): simplest, good for a single backend.
#   - Transaction pooler (port 6543): use if you hit connection limits.
#
# To migrate + verify:
#   SUPABASE_DATABASE_URL="postgresql://..." python scripts/setup_supabase.py
# Then set DATABASE_URL to the same string in Railway/.env and redeploy.
SUPABASE_DATABASE_URL=

# Alternative SDK-based backend (used only when DATABASE_URL is NOT set)
USE_SUPABASE=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ---------------------------------------------------------------------------
# Twilio (Real SMS alerts)
# ---------------------------------------------------------------------------
USE_TWILIO=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_PHONE=+1234567890

# ---------------------------------------------------------------------------
# Caregiver
# ---------------------------------------------------------------------------
CAREGIVER_PHONE=+0987654321

# ---------------------------------------------------------------------------
# Gemini API
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# ---------------------------------------------------------------------------
# Vapi & Cartesia
# ---------------------------------------------------------------------------
CARTESIA_API_KEY=your_cartesia_api_key
VAPI_SERVER_KEY=your_vapi_server_key
VAPI_CLIENT_KEY=your_vapi_client_key

# ---------------------------------------------------------------------------
# Dev alerting — Twilio quota exhaustion + auth health
# ---------------------------------------------------------------------------
# Optional webhook (Slack / Discord / ntfy / custom) that gets POSTed to when
# the backend needs attention:
#   - Twilio hits its daily message limit (error 63038)
#   - CLERK_SECRET_KEY is missing in a production-like environment (auth
#     effectively disabled)
#   - a sustained spike of rejected Clerk session tokens (broken frontend
#     login flow or brute-force attempt)
# Without this, issues are only logged. At most one notification per hour.
# Example webhook (paste your own Slack / Discord / ntfy incoming-webhook URL):
#   https://example.com/webhooks/your-incoming-webhook-url
DEV_ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Rate limiting — per-IP protection for the API-key + Clerk login endpoints
# ---------------------------------------------------------------------------
# Dependency-free in-memory limiter (single Railway replica). Two tiers:
#   1. General cap: max requests/minute/IP on protected routes.
#   2. Auth-failure blocker: IPs producing too many 401s are blocked for
#      RATE_LIMIT_BLOCK_SECONDS (brute-force protection).
# Webhook endpoints (/twilio-webhook, /bolna-webhook) and /health are exempt.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=600
RATE_LIMIT_FAILURES_PER_WINDOW=20
RATE_LIMIT_FAILURE_WINDOW_SECONDS=600
RATE_LIMIT_BLOCK_SECONDS=900

# ---------------------------------------------------------------------------
# Ops — auth health
# ---------------------------------------------------------------------------
# GET /health/auth reports auth configuration state (never secrets): 200 when
# secure, 503 when insecure. railway.toml points the Railway healthcheck here.
# GET /auth/events lists recent rate-limit blocks and auth alerts (Clerk-
# protected). The startup guard refuses to boot without CLERK_SECRET_KEY in
# production-like environments; DEV_ALERT_WEBHOOK_URL pages the team if it
# ever drifts.
# See also scripts/smoke_test_login.py for an end-to-end login-flow smoke
# test (dev mode by default; production mode with a real Clerk --token;
# --live BASE_URL probes a deployed backend's fail-closed contract).

# ---------------------------------------------------------------------------
# OpenRouter — Nemotron Watchdog Brain
# ---------------------------------------------------------------------------
# Powers the autonomous system health monitor.
# Model: nvidia/llama-3.1-nemotron-ultra-253b-v1
# Leave blank to disable the watchdog.
OPENROUTER_API_KEY=
