# WellRing Voice Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ---------------------------------------------------------------------------
# API Authentication — REQUIRED, no default
# ---------------------------------------------------------------------------
WELLRING_API_KEY=your-secure-api-key-here

# ---------------------------------------------------------------------------
# Clerk — verified session auth (REQUIRED in production)
# ---------------------------------------------------------------------------
# Secret key from Clerk Dashboard → API Keys (sk_...).
# When set, every dashboard/outbound endpoint requires a valid Clerk session
# JWT (Authorization: Bearer ...) from the frontend and the verified user id
# (the JWT `sub`) overrides any client-supplied `clerk_id`. When UNSET the
# backend runs in dev mode: verification is skipped and the legacy `clerk_id`
# request field is trusted instead.
CLERK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Database — PostgreSQL (recommended for production)
# ---------------------------------------------------------------------------
# Set DATABASE_URL to enable Postgres mode.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Example (local): postgresql://postgres:password@localhost:5432/wellring
# Example (Render): postgresql://wellring_user:xxx@dpg-xxx.render.com/wellring
DATABASE_URL=

# Optional: Staging database URL (e.g. created via scripts/setup_staging_db.sh)
STAGING_DATABASE_URL=

# After setting DATABASE_URL, run the schema migration once:
#   python -m src.db.migrate

# ---------------------------------------------------------------------------
# Database — SQLite (local dev / tests fallback)
# ---------------------------------------------------------------------------
# Only used when DATABASE_URL is not set.
WELLRING_DB_PATH=wellring.db

# ---------------------------------------------------------------------------
# Supabase — managed Postgres (option: use Supabase as the main database)
# ---------------------------------------------------------------------------
# Supabase IS PostgreSQL, so the backend needs no code changes — just point
# DATABASE_URL at Supabase's Postgres.
#
# Get the connection string from: Supabase Dashboard → Project Settings →
# Database → Connection string → "URI".
#   - Direct connection (port 5432): simplest, good for a single backend.
#   - Transaction pooler (port 6543): use if you hit connection limits.
#
# To migrate + verify:
#   SUPABASE_DATABASE_URL="postgresql://..." python scripts/setup_supabase.py
# Then set DATABASE_URL to the same string in Railway/.env and redeploy.
SUPABASE_DATABASE_URL=

# Alternative SDK-based backend (used only when DATABASE_URL is NOT set)
USE_SUPABASE=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ---------------------------------------------------------------------------
# Twilio (Real SMS alerts)
# ---------------------------------------------------------------------------
USE_TWILIO=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_PHONE=+1234567890

# ---------------------------------------------------------------------------
# Caregiver
# ---------------------------------------------------------------------------
CAREGIVER_PHONE=+0987654321

# ---------------------------------------------------------------------------
# Gemini API
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# ---------------------------------------------------------------------------
# Vapi & Cartesia
# ---------------------------------------------------------------------------
CARTESIA_API_KEY=your_cartesia_api_key
VAPI_SERVER_KEY=your_vapi_server_key
VAPI_CLIENT_KEY=your_vapi_client_key

# ---------------------------------------------------------------------------
# Dev alerting — Twilio quota exhaustion
# ---------------------------------------------------------------------------
# Optional webhook (Slack / Discord / ntfy / custom) that gets POSTed to
# when Twilio hits its daily message limit (error 63038). Without this,
# quota errors are only logged. At most one notification per hour.
# Example webhook (paste your own Slack / Discord / ntfy incoming-webhook URL):
#   https://example.com/webhooks/your-incoming-webhook-url
DEV_ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# OpenRouter — Nemotron Watchdog Brain
# ---------------------------------------------------------------------------
# Powers the autonomous system health monitor.
# Model: nvidia/llama-3.1-nemotron-ultra-253b-v1
# Leave blank to disable the watchdog.
OPENROUTER_API_KEY=
